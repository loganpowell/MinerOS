# MinerU VLM inference server
# Loaded automatically by `mineru` CLI via python-dotenv.
# This file is in .gitignore — do not commit.

MINERU_VL_SERVER=https://your-container-apps-url.random-5330.eastus.azurecontainerapps.io
MINERU_VL_API_KEY=your_api_key_here
MINERU_VL_MODEL_NAME=your_model_name_here

# Process one page per request — required because the server's n_ctx=8192 is
# too small for MinerU's default window of 64 pages.
MINEROS_PROCESSING_WINDOW_SIZE=12
